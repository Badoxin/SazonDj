# Copia este archivo a ".env" y llena los valores. El archivo ".env" NO se sube a GitHub.

# Llave secreta de Django (obligatoria). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# En desarrollo True; en producción SIEMPRE False
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Mostrar Swagger (/swagger/) y ReDoc (/redoc/). Ponlo en False en producción.
DJANGO_ENABLE_DOCS=True

# ---- Base de datos ----
# sqlite = sin configurar nada (archivo db.sqlite3). mysql = el mismo servidor de MySQL Workbench.
DB_ENGINE=mysql
DB_NAME=sazon_django
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- API externa (recetas) ----
THEMEALDB_API_KEY=1
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1
