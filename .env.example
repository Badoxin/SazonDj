# Copia este archivo a ".env". El archivo ".env" NO se sube a GitHub.
# (Las variables del frontend deben empezar con VITE_ y son PÚBLICAS: nunca pongas aquí secretos.)

# Dirección del backend de Django
VITE_BASE_API_URL=http://localhost:8000

# Nombre con el que se guarda el token en localStorage
VITE_LOCAL_STORAGE_ITEM_NAME=TOKEN
